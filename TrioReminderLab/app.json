{
  "expo": {
    "name": "Trio Reminder Lab",
    "slug": "trio-reminder-lab",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "android": {
      "package": "com.trio.reminderlab",
      "adaptiveIcon": {
        "backgroundColor": "#D9EAE3"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.USE_EXACT_ALARM",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"
      ]
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.trio.reminderlab",
      "infoPlist": {
        "UIBackgroundModes": ["remote-notification"]
      }
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "color": "#3F7D6B"
        }
      ]
    ],
    "extra": {
      "note": "This is a reliability test harness, not the product. See README.md."
    }
  }
}
