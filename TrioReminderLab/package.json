{
  "name": "trio-reminder-lab",
  "version": "0.1.0",
  "private": true,
  "description": "A focused Expo prototype to measure whether expo-notifications delivers reminders reliably on aggressive-OEM Android devices, before committing the full ADHD to-do app to React Native.",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "test": "jest"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "1.23.1",
    "expo": "~52.0.0",
    "expo-constants": "~17.0.3",
    "expo-device": "~7.0.1",
    "expo-intent-launcher": "~12.0.1",
    "expo-notifications": "~0.29.11",
    "expo-status-bar": "~2.0.0",
    "react": "18.3.1",
    "react-native": "0.76.5"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/react": "~18.3.12",
    "jest": "^29.7.0",
    "jest-expo": "~52.0.0",
    "ts-jest": "^29.2.5",
    "typescript": "~5.3.3"
  }
}
